# Copy to .env to change a value. Every variable has a working default, so
# the application also runs without a .env file.

# ---- Docker Compose (docker-compose.yml) ----
POSTGRES_DB=irigasi
POSTGRES_USER=irigasi
POSTGRES_PASSWORD=irigasi
# data/ at the repo root, mounted read-only into the container. When it holds
# source files (the checker puts its data set there) it replaces ./data.
DATA_OVERRIDE_PATH=../data
# Host port of the API.
HTTP_PORT=8080

# ---- Server on the host (make run) ----
APP_ENV=development
HTTP_ADDR=:8080
# Serve Swagger UI (/swagger/index.html) and Scalar (/scalar).
DOCS_ENABLED=true
SHUTDOWN_TIMEOUT=15s
# Longest time one request may run, database queries included.
REQUEST_TIMEOUT=60s
DATABASE_URL=postgres://irigasi:irigasi@localhost:5432/irigasi?sslmode=disable
# How long startup waits for PostgreSQL to accept connections.
DATABASE_WAIT=3m
# Folder holding the five source files; imported when the server starts.
DATA_DIR=./data
# Imported instead of DATA_DIR when it holds source files.
DATA_OVERRIDE_DIR=../data

# Integration tests (make test-integration) 
# A PostgreSQL with PostGIS that the tests may rewrite. Never point this at real data.
# TEST_DATABASE_URL=postgres://test:test@localhost:55432/test?sslmode=disable
